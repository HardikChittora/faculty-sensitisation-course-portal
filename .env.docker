# ============================================================
# Faculty Sensitisation Portal - Docker Environment Template
# Copy this file to .env and fill in your real values
# ============================================================

# Server Port (keep as 5000 - matches docker-compose port mapping)
PORT=5000

# PostgreSQL - Auto-configured by docker-compose, do NOT change these
DATABASE_URL=postgresql://fscp_admin:fscp_secret_pass@postgres:5432/faculty_course_portal

# Institute Email Domain (used to validate faculty email on login)
ZIMBRA_DOMAIN=iitkgp.ac.in

# SMTP Email Config (for sending OTP emails)
# --- For Local Testing: use Mailtrap (port 2525) ---
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=your_mailtrap_username
# SMTP_PASS=your_mailtrap_password

# --- For Institute/Production: use Gmail SMTP or Zimbra ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tech.tsgiitkgp@gmail.com
SMTP_PASS=your_16_letter_gmail_app_password_here
