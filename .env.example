# Copy this file to .env. Both npm and Docker Compose use that same file.
# Set your own secrets below; there are no default passwords.
# Single-quote values containing $ or # so Compose treats them literally.

# Express serves the API and built frontend on this port.
PORT=9501

# PostgreSQL: local tools connect to localhost:5440.
# Compose changes only the app's DB_HOST/DB_PORT to postgres:5432 internally.
DB_HOST=localhost
DB_PORT=5440
DB_USER=fscp_admin
DB_PASSWORD=
DB_NAME=faculty_course_portal

# First-time administrator seed only: set a full email and strong password,
# run npm run admin:seed, then remove these values from .env.
# Subsequent logins use the database hash; re-seeding preserves existing credentials.
# These variables are server-only; never prefix secrets with VITE_.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Institute mail authentication (used by the password-login API).
# Keep development bypass disabled on any shared deployment.
ZIMBRA_HOST=
ZIMBRA_PORT=993
ZIMBRA_DOMAIN=iitkgp.ac.in
ZIMBRA_DEV_MODE=false

# Faculty OTP delivery and course-query emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL=

# Local testing only: print OTPs in the server console instead of emailing them.
OTP_DEV_MODE=false
