# Server Port
PORT=5000

# PostgreSQL Cloud Database Connection (Neon / Supabase)
DATABASE_URL=postgresql://user:password@ep-sample-123.neon.tech/neondb?sslmode=require

# Zimbra Mail Server Configuration
ZIMBRA_HOST=mail.institute.edu.in
ZIMBRA_PORT=993
ZIMBRA_USE_SSL=true
ZIMBRA_DOMAIN=institute.edu.in
# Set to false for live Zimbra IMAPS authentication, true for local offline testing
ZIMBRA_DEV_MODE=true
