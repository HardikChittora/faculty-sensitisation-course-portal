# Server Port
PORT=5000

# Docker PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=fscp_admin
DB_PASSWORD=fscp_secret_pass
DB_NAME=faculty_course_portal
DATABASE_URL=postgresql://fscp_admin:fscp_secret_pass@localhost:5432/faculty_course_portal

# Zimbra Mail Server Configuration
# Provide your institute Zimbra server details here
ZIMBRA_HOST=mail.institute.edu.in
ZIMBRA_PORT=993
ZIMBRA_USE_SSL=true
ZIMBRA_DOMAIN=institute.edu.in
# Set to true for offline / local testing without live Zimbra server
ZIMBRA_DEV_MODE=true
